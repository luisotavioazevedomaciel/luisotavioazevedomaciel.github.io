---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteContent, type Locale } from '../data/siteContent';

const locale: Locale = 'en';
const content = siteContent[locale];
---

<BaseLayout title={`Writing | ${content.name}`} description="Architecture, delivery and technical leadership articles." locale={locale}>
  <section>
    <p class="section-label">Writing</p>
    <h1 class="section-title mt-3 text-4xl sm:text-5xl">Practical writing for engineers and technical teams.</h1>
    <p class="mt-5 max-w-3xl text-lg text-[var(--color-muted)]">I write about architecture, modernization, leadership and the decisions that make engineering work sustainable.</p>
  </section>

  <section class="mt-12 grid gap-6 lg:grid-cols-3">
    {content.articles.map((article) => (
      <article class="card p-6">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">{article.category}</span>
        <h2 class="mt-4 text-2xl font-semibold text-[var(--color-foreground)]">{article.title}</h2>
        <p class="mt-4 text-[var(--color-muted)]">{article.excerpt}</p>
        <div class="mt-6 flex items-center justify-between text-sm text-[var(--color-muted)]">
          <span>{article.readTime}</span>
          <a href={`/writing/${article.slug}/`} class="font-semibold text-[var(--color-accent)]">Read article →</a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
