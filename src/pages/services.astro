---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteContent, type Locale } from '../data/siteContent';

const locale: Locale = 'en';
const content = siteContent[locale];
---

<BaseLayout title={`Services | ${content.name}`} description="Consulting and mentoring services for engineering teams and individuals." locale={locale}>
  <section class="mb-12">
    <p class="section-label">Services</p>
    <h1 class="section-title mt-3 text-4xl sm:text-5xl">Two service tracks, one clear purpose.</h1>
  </section>

  <div class="grid gap-8 lg:grid-cols-2">
    <section class="card p-8">
      <p class="section-label">Consulting</p>
      <h2 class="mt-4 text-3xl font-bold text-[var(--color-foreground)]">Software Engineering & Architecture Consulting</h2>
      <p class="mt-4 text-[var(--color-muted)]">Helping teams design, modernize and improve technical systems without unnecessary complexity.</p>
      <div class="mt-8 space-y-5">
        {content.services.map((service) => (
          <div class="rounded-xl border border-[var(--color-border)] p-4">
            <h3 class="text-lg font-semibold text-[var(--color-foreground)]">{service.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{service.description}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 rounded-xl bg-[var(--color-accent-soft)] p-5">
        <h3 class="text-lg font-semibold text-[var(--color-foreground)]">Initial engagement packages</h3>
        <ul class="mt-4 space-y-3 text-sm text-[var(--color-foreground)]">
          {content.packages.map((pkg) => (
            <li>• <strong>{pkg.title}</strong> — {pkg.description}</li>
          ))}
        </ul>
      </div>
      <a href="/contact/" class="mt-8 inline-flex rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[var(--color-on-accent)] transition hover:bg-[var(--color-accent-hover)]">Discuss a consulting challenge</a>
    </section>

    <section class="card p-8">
      <p class="section-label">Mentoring</p>
      <h2 class="mt-4 text-3xl font-bold text-[var(--color-foreground)]">Software Engineering Mentoring</h2>
      <p class="mt-4 text-[var(--color-muted)]">Practical mentoring for engineers who want to become more effective, confident and technically capable.</p>
      <div class="mt-8 space-y-5">
        {content.mentoringStages.map((stage) => (
          <div class="rounded-xl border border-[var(--color-border)] p-4">
            <h3 class="text-lg font-semibold text-[var(--color-foreground)]">{stage.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{stage.description}</p>
          </div>
        ))}
      </div>
      <a href="/contact/" class="mt-8 inline-flex rounded-full border border-[var(--color-border)] px-6 py-3 text-sm font-semibold text-[var(--color-foreground)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">Ask about mentoring</a>
    </section>
  </div>
</BaseLayout>
