---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteContent, type Locale } from '../../data/siteContent';

const locale: Locale = 'pt';
const content = siteContent[locale];
---

<BaseLayout title={`Serviços | ${content.name}`} description="Serviços de consultoria e mentoria para equipes e profissionais de engenharia." locale={locale}>
  <section class="mb-12">
    <p class="section-label">Serviços</p>
    <h1 class="section-title mt-3 text-4xl sm:text-5xl">Duas linhas de atuação, um objetivo claro.</h1>
  </section>

  <div class="grid gap-8 lg:grid-cols-2">
    <section class="card p-8">
      <p class="section-label">Consultoria</p>
      <h2 class="mt-4 text-3xl font-bold text-[var(--color-foreground)]">Consultoria em engenharia de software e arquitetura</h2>
      <p class="mt-4 text-[var(--color-muted)]">Ajudando times a desenhar, modernizar e melhorar sistemas técnicos sem complexidade desnecessária.</p>
      <div class="mt-8 space-y-5">
        {content.services.map((service) => (
          <div class="rounded-xl border border-[var(--color-border)] p-4">
            <h3 class="text-lg font-semibold text-[var(--color-foreground)]">{service.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{service.description}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 rounded-xl bg-[var(--color-accent-soft)] p-5">
        <h3 class="text-lg font-semibold text-[var(--color-foreground)]">Pacotes iniciais de engagement</h3>
        <ul class="mt-4 space-y-3 text-sm text-[var(--color-foreground)]">
          {content.packages.map((pkg) => (
            <li>• <strong>{pkg.title}</strong> — {pkg.description}</li>
          ))}
        </ul>
      </div>
      <a href="/pt/contato/" class="mt-8 inline-flex rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">Fale comigo sobre consultoria</a>
    </section>

    <section class="card p-8">
      <p class="section-label">Mentoria</p>
      <h2 class="mt-4 text-3xl font-bold text-[var(--color-foreground)]">Mentoria em engenharia de software</h2>
      <p class="mt-4 text-[var(--color-muted)]">Mentoria prática para engenheiros que querem se tornar mais efetivos, confiantes e competentes tecnicamente.</p>
      <div class="mt-8 space-y-5">
        {content.mentoringStages.map((stage) => (
          <div class="rounded-xl border border-[var(--color-border)] p-4">
            <h3 class="text-lg font-semibold text-[var(--color-foreground)]">{stage.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{stage.description}</p>
          </div>
        ))}
      </div>
      <a href="/pt/contato/" class="mt-8 inline-flex rounded-full border border-[var(--color-border)] px-6 py-3 text-sm font-semibold text-[var(--color-foreground)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">Pergunte sobre mentoria</a>
    </section>
  </div>
</BaseLayout>
