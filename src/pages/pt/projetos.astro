---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteContent, type Locale } from '../../data/siteContent';

const locale: Locale = 'pt';
const content = siteContent[locale];
---

<BaseLayout title={`Projetos | ${content.name}`} description="Projetos e estudos de caso em engenharia." locale={locale}>
  <section>
    <p class="section-label">Projetos</p>
    <h1 class="section-title mt-3 text-4xl sm:text-5xl">Estudos de caso selecionados.</h1>
    <p class="mt-5 max-w-3xl text-lg text-[var(--color-muted)]">Trabalho com times de produto e engenharia para simplificar complexidade, melhorar entrega e criar sistemas mais resilientes.</p>
  </section>

  <section class="mt-12 grid gap-6 lg:grid-cols-3">
    {content.caseStudies.map((project) => (
      <article class="card p-6">
        <div class="flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <span class="rounded-full bg-[var(--color-accent-soft)] px-2.5 py-1 text-xs font-medium text-[var(--color-accent)]">{tag}</span>
          ))}
        </div>
        <h2 class="mt-5 text-2xl font-semibold text-[var(--color-foreground)]">{project.title}</h2>
        <p class="mt-4 text-[var(--color-muted)]">{project.summary}</p>
        <p class="mt-4 text-sm font-medium text-[var(--color-foreground)]">{project.outcome}</p>
        <a href={`/pt/projetos/${project.slug}/`} class="mt-6 inline-flex font-semibold text-[var(--color-accent)]">Ler estudo →</a>
      </article>
    ))}
  </section>
</BaseLayout>
