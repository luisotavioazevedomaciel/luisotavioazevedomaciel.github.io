---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteContent, type Locale } from '../data/siteContent';
import homePortrait from '../../homepage-image.jpeg';

const locale: Locale = 'en';
const content = siteContent[locale];
---

<BaseLayout
  title={`${content.name} | ${content.title}`}
  description={content.description}
  locale={locale}
  compactTop
>
  <section class="grid grid-cols-1 items-center gap-8 md:grid-cols-[minmax(0,1fr)_14rem] md:gap-12">
    <Image
      src={homePortrait}
      alt="Portrait of Luís Otávio Azevedo Maciel"
      width={480}
      height={480}
      class="order-first mx-auto aspect-square w-36 rounded-xl object-cover md:order-last md:w-56"
    />
    <div class="max-w-3xl">
      <span class="eyebrow">{content.hero.eyebrow}</span>
      <h1 class="mt-6 text-4xl font-black tracking-tight text-[var(--color-foreground)] sm:text-5xl lg:text-6xl">
        {content.hero.title}<br />
        <span class="text-[var(--color-accent)]">{content.hero.subtitle}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-[var(--color-muted)]">{content.intro}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={content.hero.primaryHref} class="rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[var(--color-on-accent)] transition hover:bg-[var(--color-accent-hover)]">
          {content.hero.primaryCta}
        </a>
        <a href={content.hero.secondaryHref} class="rounded-full border border-[var(--color-border)] px-6 py-3 text-sm font-semibold text-[var(--color-foreground)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">
          {content.hero.secondaryCta}
        </a>
      </div>
    </div>
  </section>

  <section class="mt-12 border-y border-[var(--color-border)] bg-[var(--color-accent-soft)] px-5 py-8 sm:px-8 lg:flex lg:items-center lg:justify-between lg:gap-8">
    <div>
      <p class="section-label">Services</p>
      <h2 class="mt-2 text-xl font-semibold text-[var(--color-foreground)]">Consulting and mentoring for better engineering.</h2>
      <p class="mt-2 max-w-2xl text-sm text-[var(--color-muted)]">Practical support for teams building reliable systems and engineers growing their technical leadership.</p>
    </div>
    <a href="/services/" class="mt-5 inline-flex shrink-0 rounded-full border border-[var(--color-border)] px-5 py-2.5 text-sm font-semibold text-[var(--color-foreground)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] lg:mt-0">Explore services →</a>
  </section>

  <section class="mt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="section-label">Selected work</p>
        <h2 class="section-title">Projects and engineering outcomes that matter.</h2>
      </div>
      <a href="/work/" class="text-sm font-semibold text-[var(--color-accent)] transition hover:text-[var(--color-foreground)]">All work →</a>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">
      {content.caseStudies.slice(0, 2).map((project) => (
        <article class="card p-6">
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full bg-[var(--color-accent-soft)] px-2.5 py-1 text-xs font-medium text-[var(--color-accent)]">{tag}</span>
            ))}
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[var(--color-foreground)]">{project.title}</h3>
          <p class="mt-3 text-sm text-[var(--color-muted)]">{project.summary}</p>
          <p class="mt-4 text-sm font-medium text-[var(--color-foreground)]">{project.outcome}</p>
          <a href={`/work/${project.slug}/`} class="mt-5 inline-flex text-sm font-semibold text-[var(--color-accent)]">Read the case study →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="section-label">Writing</p>
        <h2 class="section-title">Articles on architecture, delivery and technical leadership.</h2>
      </div>
      <a href="/writing/" class="text-sm font-semibold text-[var(--color-accent)] transition hover:text-[var(--color-foreground)]">All writing →</a>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">
      {content.articles.slice(0, 2).map((article) => (
        <article class="card p-6">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">{article.category}</span>
          <h3 class="mt-4 text-xl font-semibold text-[var(--color-foreground)]">{article.title}</h3>
          <p class="mt-3 text-sm text-[var(--color-muted)]">{article.excerpt}</p>
          <div class="mt-5 flex items-center justify-between text-xs text-[var(--color-muted)]">
            <span>{article.readTime}</span>
            <a href={`/writing/${article.slug}/`} class="font-semibold text-[var(--color-accent)]">Read →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
