---
import { type Locale } from '../data/siteContent';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const label = locale === 'en' ? 'Dark mode' : 'Tema escuro';
const visibleLabel = locale === 'en' ? 'Dark' : 'Escuro';
---
<button
  id="theme-toggle"
  type="button"
  role="switch"
  aria-label={label}
  aria-checked="false"
  class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 text-sm font-medium text-[var(--color-foreground)] transition hover:border-[var(--color-accent)]"
>
  <span>{visibleLabel}</span>
  <span aria-hidden="true" class="theme-track inline-flex h-5 w-9 items-center rounded-full bg-[var(--color-highlight)] p-0.5 transition-colors">
    <span class="theme-thumb h-4 w-4 rounded-full bg-[var(--color-surface)] shadow-sm transition-transform"></span>
  </span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');

  if (button) {
    const syncSwitch = () => {
      button.setAttribute('aria-checked', String(root.dataset.theme === 'dark'));
    };

    syncSwitch();
    button.addEventListener('click', () => {
      const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      localStorage.setItem('theme', theme);
      syncSwitch();
    });
  }
</script>

<style>
  #theme-toggle[aria-checked='true'] .theme-track {
    background: var(--color-accent);
  }

  #theme-toggle[aria-checked='true'] .theme-thumb {
    transform: translateX(1rem);
  }
</style>
