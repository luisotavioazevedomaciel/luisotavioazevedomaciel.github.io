---
import { type Locale } from '../data/siteContent';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const darkLabel = locale === 'en' ? 'Dark' : 'Escuro';
const lightLabel = locale === 'en' ? 'Light' : 'Claro';
---
<button
  id="theme-toggle"
  type="button"
  class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-2 py-2 text-sm font-medium text-[var(--color-foreground)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] sm:px-3"
  aria-label={locale === 'en' ? 'Toggle color theme' : 'Alternar tema de cores'}
  data-dark-label={darkLabel}
  data-light-label={lightLabel}
>
  <span aria-hidden="true">🌙</span>
  <span class="theme-label hidden sm:inline">{darkLabel}</span>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const label = button?.querySelector('.theme-label');
  const darkLabel = button?.getAttribute('data-dark-label') ?? 'Dark';
  const lightLabel = button?.getAttribute('data-light-label') ?? 'Light';

  const applyTheme = (theme) => {
    root.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    if (label) {
      label.textContent = theme === 'dark' ? lightLabel : darkLabel;
    }
    if (button) {
      const icon = button.querySelector('span[aria-hidden="true"]');
      if (icon) {
        icon.textContent = theme === 'dark' ? '☀️' : '🌙';
      }
    }
  };

  const storedTheme = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const initialTheme = storedTheme ?? (prefersDark ? 'dark' : 'light');
  applyTheme(initialTheme);

  button?.addEventListener('click', () => {
    const currentTheme = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    applyTheme(currentTheme === 'dark' ? 'light' : 'dark');
  });
</script>
