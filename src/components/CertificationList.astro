---
import { type Certification } from '../data/siteContent';

const { certifications } = Astro.props as { certifications: Certification[] };
---

<ul class="mt-6 grid gap-3 sm:grid-cols-2">
  {certifications.map((certification) => (
    <li class="flex items-center gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-accent-soft)] px-4 py-3 text-sm text-[var(--color-foreground)]">
      <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-foreground)]">
        {certification.icon === 'cloud' ? (
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5">
            <path d="M7.5 18.25h9.75a3.75 3.75 0 0 0 .45-7.47 5.75 5.75 0 0 0-11.2.9 3.3 3.3 0 0 0 1 6.57Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        ) : certification.icon === 'code' ? (
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5">
            <path d="m8.5 8-4 4 4 4m7-8 4 4-4 4m-2.25-9-2.5 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        ) : certification.icon === 'pipeline' ? (
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5">
            <circle cx="6" cy="6" r="2.25" stroke="currentColor" stroke-width="1.6" />
            <circle cx="18" cy="18" r="2.25" stroke="currentColor" stroke-width="1.6" />
            <path d="M8.25 6h3a3 3 0 0 1 3 3v3a3 3 0 0 0 3 3h.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        ) : (
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5">
            <path d="m12 3.75 8 4.5v7.5l-8 4.5-8-4.5v-7.5l8-4.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <path d="m4.5 8.5 7.5 4.25 7.5-4.25M12 12.75v7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          </svg>
        )}
      </span>
      <span>{certification.label}</span>
    </li>
  ))}
</ul>
