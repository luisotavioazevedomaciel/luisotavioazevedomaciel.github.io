---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { siteContent, type Locale } from '../data/siteContent';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const content = siteContent[locale];
---
<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-background)]/80 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 py-3 sm:gap-4 sm:px-6 sm:py-4 lg:px-8">
    <a href={content.nav[0].href} class="text-sm font-semibold tracking-tight text-[var(--color-foreground)] sm:text-base">
      <span class="sm:hidden">Luís Maciel</span>
      <span class="hidden sm:inline">{content.name}</span>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-[var(--color-muted)] md:flex">
      {content.nav.map((item) => (
        <a href={item.href} class="transition hover:text-[var(--color-foreground)]">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-2 py-2 text-sm font-medium text-[var(--color-foreground)]">
          Menu
        </summary>
        <nav class="absolute right-0 top-full mt-2 flex min-w-48 flex-col gap-1 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-2 text-sm font-medium text-[var(--color-foreground)] shadow-lg">
          {content.nav.map((item) => (
            <a href={item.href} class="rounded-lg px-3 py-2 transition hover:bg-[var(--color-accent-soft)] hover:text-[var(--color-accent)]">
              {item.label}
            </a>
          ))}
        </nav>
      </details>
      <LanguageSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
