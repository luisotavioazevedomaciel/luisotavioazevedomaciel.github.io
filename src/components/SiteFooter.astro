---
import { siteContent, type Locale } from '../data/siteContent';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const content = siteContent[locale];
---
<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[1.5fr_1fr_1fr] lg:px-8">
    <div>
      <p class="text-lg font-semibold text-[var(--color-foreground)]">{content.name}</p>
      <p class="mt-3 max-w-md text-sm text-[var(--color-muted)]">{content.footer}</p>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.12em] text-[var(--color-muted)]">Navigation</p>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-foreground)]">
        {content.nav.slice(0, 5).map((item) => (
          <li><a href={item.href} class="transition hover:text-[var(--color-accent)]">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.12em] text-[var(--color-muted)]">Contact</p>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-foreground)]">
        {content.contactLinks.map((link) => (
          <li><a href={link.href} class="transition hover:text-[var(--color-accent)]">{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
